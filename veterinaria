<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>PetCare Veterinaria | Cuidamos a tu mascota</title>

    <!-- Bootstrap 5 -->
    <link 
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" 
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link 
        rel="stylesheet" 
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link 
        href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" 
        rel="stylesheet"
    >

    <style>

        /* ==============================
           ESTILOS GENERALES
        ============================== */

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #fffdf8;
            color: #333;
        }

        section {
            scroll-margin-top: 80px;
        }

        .section-title {
            font-weight: 700;
            color: #174c43;
        }

        .section-subtitle {
            color: #777;
        }

        /* ==============================
           NAVBAR
        ============================== */

        .navbar {
            background-color: #ffffff;
            box-shadow: 0 3px 15px rgba(0,0,0,0.08);
        }

        .navbar-brand {
            font-size: 1.5rem;
            font-weight: 800;
            color: #174c43 !important;
        }

        .navbar-brand i {
            color: #f4a261;
        }

        .nav-link {
            font-weight: 500;
            color: #333 !important;
            margin-left: 10px;
        }

        .nav-link:hover {
            color: #e76f51 !important;
        }

        .btn-main {
            background-color: #e76f51;
            color: white;
            border: none;
            border-radius: 30px;
            padding: 11px 24px;
            font-weight: 600;
            transition: 0.3s;
        }

        .btn-main:hover {
            background-color: #d9573b;
            color: white;
            transform: translateY(-2px);
        }

        /* ==============================
           HERO
        ============================== */

        .hero {
            min-height: 90vh;
            display: flex;
            align-items: center;
            background:
                linear-gradient(
                    rgba(23, 76, 67, 0.82),
                    rgba(23, 76, 67, 0.82)
                ),
                url("https://images.unsplash.com/photo-1548199973-03cce0bbc87b?auto=format&fit=crop&w=1600&q=80");
            background-size: cover;
            background-position: center;
            color: white;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 6vw, 4.5rem);
            font-weight: 800;
            line-height: 1.1;
        }

        .hero p {
            font-size: 1.1rem;
            max-width: 650px;
            color: #f1f1f1;
        }

        .hero .btn-light {
            border-radius: 30px;
            padding: 12px 25px;
            font-weight: 600;
        }

        .hero-badge {
            display: inline-block;
            background: #f4a261;
            padding: 8px 18px;
            border-radius: 30px;
            font-weight: 600;
            margin-bottom: 20px;
        }

        /* ==============================
           SERVICIOS
        ============================== */

        .service-card {
            border: none;
            border-radius: 20px;
            padding: 30px 20px;
            height: 100%;
            background: white;
            box-shadow: 0 8px 25px rgba(0,0,0,0.07);
            transition: 0.3s;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        }

        .service-icon {
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto;
            border-radius: 50%;
            background: #e8f4f0;
            color: #174c43;
            font-size: 2rem;
        }

        .service-card h5 {
            font-weight: 700;
            margin-top: 20px;
            color: #174c43;
        }

        /* ==============================
           CARRUSEL
        ============================== */

        .carousel-item img {
            height: 500px;
            object-fit: cover;
            border-radius: 20px;
        }

        .carousel-caption {
            background: rgba(0,0,0,0.55);
            border-radius: 15px;
            padding: 20px;
        }

        /* ==============================
           PRODUCTOS
        ============================== */

        .product-card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            background: white;
            box-shadow: 0 7px 25px rgba(0,0,0,0.08);
            transition: 0.3s;
            height: 100%;
        }

        .product-card:hover {
            transform: translateY(-6px);
        }

        .product-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .product-body {
            padding: 20px;
        }

        .product-body h5 {
            font-weight: 700;
            color: #174c43;
        }

        .price {
            color: #e76f51;
            font-size: 1.2rem;
            font-weight: 700;
        }

        /* ==============================
           PROMOCIÓN
        ============================== */

        .promo {
            background-color: #f4a261;
            color: white;
            border-radius: 25px;
            padding: 50px 30px;
        }

        .promo h2 {
            font-weight: 800;
        }

        /* ==============================
           FAQ
        ============================== */

        .accordion-item {
            border: none;
            margin-bottom: 12px;
            border-radius: 12px !important;
            overflow: hidden;
            box-shadow: 0 3px 15px rgba(0,0,0,0.06);
        }

        .accordion-button {
            font-weight: 600;
            color: #174c43;
            background: white;
        }

        .accordion-button:not(.collapsed) {
            background-color: #e8f4f0;
            color: #174c43;
            box-shadow: none;
        }

        /* ==============================
           CONTACTO
        ============================== */

        .contact-section {
            background-color: #e8f4f0;
        }

        .contact-card {
            background: white;
            border-radius: 20px;
            padding: 35px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .form-control {
            border-radius: 12px;
            padding: 12px 15px;
            border: 1px solid #ddd;
        }

        .form-control:focus {
            border-color: #e76f51;
            box-shadow: 0 0 0 0.2rem rgba(231,111,81,0.15);
        }

        /* ==============================
           FOOTER
        ============================== */

        footer {
            background-color: #174c43;
            color: white;
        }

        footer h5 {
            font-weight: 700;
        }

        footer a {
            color: #d9e8e4;
            text-decoration: none;
        }

        footer a:hover {
            color: #f4a261;
        }

        .social-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background-color: rgba(255,255,255,0.1);
            color: white;
            margin-right: 8px;
            transition: 0.3s;
        }

        .social-icon:hover {
            background-color: #f4a261;
            color: white;
            transform: translateY(-3px);
        }

        /* ==============================
           RESPONSIVE
        ============================== */

        @media (max-width: 768px) {

            .hero {
                min-height: 80vh;
                text-align: center;
            }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .carousel-item img {
                height: 350px;
            }

            .carousel-caption {
                padding: 10px;
            }

            .carousel-caption h5 {
                font-size: 1rem;
            }

            .carousel-caption p {
                font-size: 0.8rem;
            }
        }

    </style>
</head>

<body>

